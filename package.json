{
  "name": "andai",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc --noEmit",
    "tauri": "bunx --bun tauri",
    "build:mac-arm64": "bunx --bun tauri build --config src-tauri/tauri.laya.conf.json",
    "deploy:web": "bun run build && firebase deploy --only hosting",
    "postinstall": "bun scripts/copy-wllama.mjs && bun scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ug": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored --skip laya --skip llm_",
    "test:laya": "cargo test --release --manifest-path src-tauri/Cargo.toml -- --ignored laya --nocapture --test-threads=1",
    "test:llm": "cargo test --release --manifest-path src-tauri/Cargo.toml -- --ignored llm_ --nocapture --test-threads=1",
    "test:e2e": "bun scripts/e2e.mjs",
    "test:e2e:release": "bun scripts/e2e.mjs --release",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "perf": "bun scripts/perf.mjs",
    "eval:agent": "bun scripts/eval-agent.mjs",
    "eval:view": "bun scripts/eval-view.mjs",
    "bench:engine": "bun scripts/bench-engine.mjs",
    "audit": "bun audit --audit-level=high && cargo audit --file src-tauri/Cargo.lock",
    "check": "bun run typecheck && bun run test && bun run test:rust && bun run lint:rust",
    "version": "bun scripts/version.mjs",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@wllama/wllama": "3.6.1",
    "@wllama/wllama-compat": "3.6.1",
    "firebase": "12.19.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
