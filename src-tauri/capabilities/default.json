{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Andai main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "allow-dev-log",
    "allow-dev-exit",
    "allow-ug-status",
    "allow-kb-list",
    "allow-kb-create",
    "allow-kb-add-files",
    "allow-kb-pick-files",
    "allow-kb-remove-source",
    "allow-kb-delete",
    "allow-kb-index",
    "allow-kb-search",
    "allow-kb-set-kind",
    "allow-kb-tool",
    "allow-laya-status",
    "allow-laya-write-chunk",
    "allow-laya-finish",
    "allow-laya-remove",
    "allow-laya-load",
    "allow-laya-unload",
    "allow-laya-decide"
  ],
  "remote": {
    "urls": [
      "http://localhost:14230",
      "http://localhost:14230/*"
    ]
  }
}
